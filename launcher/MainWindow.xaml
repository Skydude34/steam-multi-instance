<Window x:Class="SteamMultiInstance.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Multi-Instance Launcher" Height="420" Width="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Новый инстанс" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ID инстанса:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="InstanceIdBox" Grid.Column="1" Margin="0,0,10,0" Text="alice"/>

                <TextBlock Text="Путь к .exe:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ExePathBox" Grid.Column="3" Margin="0,0,10,0"
                         Text="C:\Program Files (x86)\Steam\steam.exe"/>

                <Button x:Name="LaunchButton" Grid.Column="4" Content="Запустить"
                        Click="OnLaunchClicked" Padding="10,2"/>
            </Grid>
        </GroupBox>

        <ListView x:Name="InstancesList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding InstanceId}" Width="100"/>
                    <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Pid}" Width="80"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding StatusText}" Width="100"/>
                    <GridViewColumn Header="Профиль" DisplayMemberBinding="{Binding ProfileDirectory}" Width="280"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" Content="Обновить" Click="OnRefreshClicked" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="KillSelectedButton" Content="Завершить выбранный" Click="OnKillSelectedClicked" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="KillAllButton" Content="Завершить всё" Click="OnKillAllClicked" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
