<Window x:Class="SteamMultiInstance.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Multi-Instance Launcher" Height="460" Width="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Новый инстанс / импорт аккаунтов" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ID инстанса:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="InstanceIdBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,4" Text="alice"/>

                <TextBlock Text="Путь к .exe:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="ExePathBox" Grid.Row="0" Grid.Column="3" Margin="0,0,10,4"
                         Text="C:\Program Files (x86)\Steam\steam.exe"/>

                <Button x:Name="LaunchButton" Grid.Row="0" Grid.Column="4" Content="Запустить"
                        Click="OnLaunchClicked" Padding="10,2" Margin="0,0,0,4"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                    <Button x:Name="ImportLogPassButton" Content="Импорт логин:пароль (.txt)"
                            Click="OnImportLogPassClicked" Padding="10,2" Margin="0,0,8,0"/>
                    <Button x:Name="ImportMaFileButton" Content="Импорт .maFile"
                            Click="OnImportMaFileClicked" Padding="10,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <ListView x:Name="InstancesList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding InstanceId}" Width="100"/>
                    <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Pid}" Width="60"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding StatusText}" Width="90"/>
                    <GridViewColumn Header="Пароль" DisplayMemberBinding="{Binding PasswordStatus}" Width="60"/>
                    <GridViewColumn Header="maFile" DisplayMemberBinding="{Binding MaFileStatus}" Width="60"/>
                    <GridViewColumn Header="Steam Guard" DisplayMemberBinding="{Binding SteamGuardCode}" Width="90"/>
                    <GridViewColumn Header="Профиль" DisplayMemberBinding="{Binding ProfileDirectory}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" Content="Обновить" Click="OnRefreshClicked" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="CopyCodeButton" Content="Скопировать Steam Guard код" Click="OnCopyCodeClicked" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="KillSelectedButton" Content="Завершить выбранный" Click="OnKillSelectedClicked" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="KillAllButton" Content="Завершить всё" Click="OnKillAllClicked" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
