<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SteamMultiInstance.Launcher</RootNamespace>
    <AssemblyName>SteamMultiInstance.Launcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI Automation для автологина (находит поля логина/пароля в окне
         Steam по их Automation-дереву, а не по хрупким координатам/хукам). -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
